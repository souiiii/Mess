{
  "name": "iiit-bhubaneswar-mess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IIIT Bhubaneswar mess operations, attendance and billing",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --import tsx --watch server/src/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "npm run typecheck && tsc -p server/tsconfig.build.json && vite build --config client/vite.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 server/test/*.test.ts",
    "db:migrate": "node --import tsx server/src/cli.ts migrate",
    "db:seed": "node --import tsx server/src/cli.ts seed",
    "admin:create": "node --import tsx server/src/cli.ts admin",
    "db:backup": "node --import tsx server/src/cli.ts backup",
    "check": "npm run typecheck && npm test && npm run test:ui && npm run build",
    "test:ui": "vitest run --config client/vitest.config.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "swagger-ui-dist": "^5.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
