{
  "name": "iiit-bhubaneswar-mess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IIIT Bhubaneswar mess operations, attendance and billing",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "npm run typecheck && tsc -p server/tsconfig.build.json && vite build --config client/vite.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 server/test/*.test.ts",
    "db:migrate": "tsx server/src/cli.ts migrate",
    "db:seed": "tsx server/src/cli.ts seed",
    "admin:create": "tsx server/src/cli.ts admin",
    "db:backup": "tsx server/src/cli.ts backup",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
